rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tarefas/{tarefaId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Tokens de dispositivo para notificações push (FCM). Cada documento
    // só pode ser lido/escrito pelo próprio dono (uid == usuário logado) —
    // as Cloud Functions acessam isso via Admin SDK, que ignora estas
    // regras (têm acesso privilegiado), então isso só restringe o acesso
    // vindo do cliente (navegador).
    match /dispositivos/{dispositivoId} {
      allow read, write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}